{
  "manifest_version": 3,
  "name": "noad",
  "version": "0.2.0",
  "description": "Blocks ads with EasyList + KoreanList, with per-site and global toggles.",
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "storage"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "filters",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "noad",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
